#cloud-config

package_update: false
package_upgrade: false

timezone: Europe/Oslo

users:
  - name: ${admin_user}
    sudo: ALL=(ALL) NOPASSWD:ALL
    groups: render, video, sudo
    shell: /bin/bash
    lock_passwd: false
    ssh_authorized_keys:
      - ${ssh_public_key}

chpasswd:
  expire: false
  users:
    - name: ${admin_user}
      password: "${admin_password}"
      type: text

write_files:

  - path: /usr/local/lib/vps-desktop/01-desktop.sh
    permissions: '0755'
    content: |
      #!/bin/bash
      set -euo pipefail
      export DEBIAN_FRONTEND=noninteractive
      export HOME=/root
      exec > /var/log/vps-desktop/01-desktop.log 2>&1

      apt-get update -qq
      export NEEDRESTART_MODE=l
      apt-get install -y gnome-session gnome-session-flashback \
        xrdp xorgxrdp dbus-x11 \
        gnome-text-editor evince gnome-disk-utility baobab \
        gnome-screenshot gnome-calculator \
        fonts-liberation fonts-noto-color-emoji fonts-ubuntu xsel \
        ripgrep ffmpeg xdg-utils

      # never let needrestart (apt hook) auto-restart xrdp/xrdp-sesman:
      # restarting the daemons mid-session orphans live RDP sessions
      # (sesman registry wiped, GNOME keeps the user D-Bus names, so the
      # next login creates a new session that dies instantly). Any later
      # apt operation (installers, unattended-upgrades) would bounce xrdp
      # again without this. override_rc=0 -> report but never restart.
      install -d /etc/needrestart/conf.d
      printf '%s\n' \
        '# xrdp MUST NOT be auto-restarted by needrestart (apt hook):' \
        '# restart orphans live RDP sessions. Restart manually during' \
        '# maintenance instead. override_rc=0 -> report, never restart.' \
        '$nrconf{override_rc} = { qr(^xrdp) => 0 };' \
        > /etc/needrestart/conf.d/xrdp.conf

      systemctl disable --now snapd 2>/dev/null || true
      systemctl disable --now NetworkManager-wait-online 2>/dev/null || true
      systemctl disable --now ModemManager 2>/dev/null || true

      # GNOME Flashback (Metacity) as default xrdp session:
      # default startwm.sh -> /etc/X11/Xsession -> Xsession.d/75dbus_dbus-launch
      # sets up the D-Bus session bus, then runs x-session-manager
      # (pointed at gnome-flashback-metacity via alternatives).
      # Do NOT write a custom startwm.sh: bypassing /etc/X11/Xsession
      # loses dbus setup and gnome-session exits instantly.
      update-alternatives --set x-session-manager /usr/libexec/gnome-flashback-metacity

      # xrdp needs the snakeoil TLS key: add xrdp user to ssl-cert
      usermod -aG ssl-cert xrdp

      # Enable and (re)start xrdp.
      # restart, not start: apt already auto-started xrdp during install,
      # and a running process does NOT pick up new supplementary groups
      # from usermod. Without a restart xrdp cannot read key.pem and
      # every session falls back to legacy RDP security.
      systemctl enable xrdp
      systemctl restart xrdp

      # Write admin password to home directory for reference
      mkdir -p /home/${admin_user}
      printf '%s' "${admin_password}" > /home/${admin_user}/.admin-password
      chmod 600 /home/${admin_user}/.admin-password
      chown ${admin_user}:${admin_user} /home/${admin_user}/.admin-password

      # /vault bookmark in the file manager (nautilus reads this file for
      # both GTK3 and GTK4 builds). "file:///vault Vault" shows a "Vault"
      # entry in the sidebar pointing at /vault. The mount is created by
      # 00-storage.sh, but the bookmark only needs the path to exist.
      VHOME=/home/${admin_user}
      # .config itself must be user-owned: dconf (lock settings, panel
      # layout) writes its DB under .config/dconf and fails silently
      # if the parent dir is root-owned. Do NOT chown -R the whole
      # .config: user-run apps may have placed root-needed files.
      chown ${admin_user}:${admin_user} "$VHOME/.config" 2>/dev/null \
        || install -d -o ${admin_user} -g ${admin_user} "$VHOME/.config"
      install -d -o ${admin_user} -g ${admin_user} "$VHOME/.config/gtk-3.0"
      if ! grep -qs "file:///vault" "$VHOME/.config/gtk-3.0/bookmarks"; then
        echo "file:///vault Vault" >> "$VHOME/.config/gtk-3.0/bookmarks"
      fi
      chown ${admin_user}:${admin_user} "$VHOME/.config/gtk-3.0/bookmarks"

      # System-wide dconf defaults: never auto-lock the screen.
      # RDP sessions must stay unlocked (the user authenticates via xrdp).
      # Written as a system db so it applies to the user before first login
      # and cannot be shadowed by a stale user dconf DB.
      install -d /etc/dconf/profile
      printf 'user-db:user\nsystem-db:vps-desktop\n' > /etc/dconf/profile/user
      install -d /etc/dconf/db/vps-desktop.d
      printf '%s\n' \
        '[org/gnome/desktop/screensaver]' \
        'lock-enabled=false' \
        'idle-activation-enabled=false' \
        'lock-delay=uint32 0' \
        '[org/gnome/desktop/session]' \
        'idle-delay=uint32 0' \
        '[org/gnome/settings-daemon/plugins/power]' \
        'idle-dim=false' \
        'sleep-inactive-ac-type=string "nothing"' \
        'sleep-inactive-battery-type=string "nothing"' \
        > /etc/dconf/db/vps-desktop.d/00-no-autolock
      dconf update

  - path: /usr/local/lib/vps-desktop/02-chrome.sh
    permissions: '0755'
    content: |
      #!/bin/bash
      set -euo pipefail
      export HOME=/root
      exec > /var/log/vps-desktop/02-chrome.log 2>&1

      wget -SL -O /tmp/google-chrome-stable.deb https://dl.google.com/linux/direct/google-chrome-stable_current_amd64.deb
      dpkg -i /tmp/google-chrome-stable.deb || apt-get install -f -y
      rm -f /tmp/google-chrome-stable.deb

  - path: /usr/local/lib/vps-desktop/00-storage.sh
    permissions: '0755'
    content: |
      #!/bin/bash
      set -euo pipefail
      exec > /var/log/vps-desktop/00-storage.log 2>&1

      # Secondary Cinder volume, attached by Terraform right after boot.
      # Device name varies by image/bus (vdX on virtio-blk, sdX on NREC GOLD images)
      # -> detect dynamically: by label first (reruns), else first non-root disk.
      LABEL=vps-storage
      MOUNT=/vault

      ROOT_DISK=$(lsblk -no PKNAME "$(findmnt -no SOURCE /)" | head -1)

      i=0
      until DEVICE=$(blkid -o device -t LABEL="$LABEL" | head -1); [ -b "$DEVICE" ] || [ "$i" -ge 60 ]; do
        DEVICE=$(lsblk -drno NAME,TYPE | awk -v r="$ROOT_DISK" '$2 == "disk" && $1 != r {print "/dev/" $1; exit}')
        [ -b "$DEVICE" ] && break
        sleep 5
        i=$((i + 1))
      done
      [ -b "$DEVICE" ] || { echo "ERROR: secondary volume not present after 300s"; exit 1; }

      # Format only once: label presence means already formatted
      if [ "$(blkid -s LABEL -o value "$DEVICE")" != "$LABEL" ]; then
        lsblk -rno TYPE "$DEVICE" | grep -q part && { echo "ERROR: $DEVICE has partitions, refusing to format"; exit 1; }
        [ -n "$(blkid -o value "$DEVICE")" ] && { echo "ERROR: $DEVICE already has a filesystem, refusing to format"; exit 1; }
        mkfs.ext4 -q -L "$LABEL" "$DEVICE"
      fi

      mkdir -p "$MOUNT"
      if ! grep -q "LABEL=$LABEL" /etc/fstab; then
        echo "LABEL=$LABEL  $MOUNT  ext4  defaults,nofail  0 2" >> /etc/fstab
      fi
      mountpoint -q "$MOUNT" || mount "$MOUNT"
      chown -R ${admin_user}:${admin_user} "$MOUNT"
      df -h "$MOUNT"

runcmd:
  - mkdir -p /var/log/vps-desktop
  # Prevent apt lock contention during provisioning
  - systemctl stop apt-daily.timer apt-daily-upgrade.timer unattended-upgrades 2>/dev/null || true
  - systemctl mask apt-daily.timer apt-daily-upgrade.timer 2>/dev/null || true
  - systemctl mask sssd 2>/dev/null || true
  - systemctl mask gnome-remote-desktop 2>/dev/null || true
  - bash /usr/local/lib/vps-desktop/00-storage.sh
  - bash /usr/local/lib/vps-desktop/01-desktop.sh
  - bash /usr/local/lib/vps-desktop/02-chrome.sh

final_message: |
  VPS ready. xrdp is running on port 3389.
  Connect: ssh -L 33389:localhost:3389 -i <key> ubuntu@<ip>
  Then connect with RDP client to localhost:33389
  Password: ${admin_password}
